{
  "$schema": "https://opencode.ai/config.json",
  "model": "local/qwen3.5-4b",
  "provider": {
    "local": {
      "name": "Local LLM (llama-server Metal GPU)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "qwen3.5-4b": {
          "name": "Qwen 3.5 4B",
          "tool_call": true,
          "limit": {
            "context": 98304,
            "output": 8192
          }
        },
        "qwen3.5-0.8b": {
          "name": "Qwen 3.5 0.8B",
          "tool_call": true,
          "limit": {
            "context": 8192,
            "output": 4096
          }
        }
      }
    }
  }
}